{
  "name": "coding-quota-bar",
  "version": "1.5.2",
  "description": "Coding Plan usage monitor - system tray resident display",
  "main": "./out/main/index.js",
  "author": "hyizhou",
  "license": "MIT",
  "scripts": {
    "dev": "chcp 65001 >nul && electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "vue-tsc -p tsconfig.node.json --noEmit && vue-tsc -p tsconfig.web.json --noEmit",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder",
    "package:dir": "npm run build && electron-builder --dir",
    "package:win": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "chart.js": "^4.5.1",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.1",
    "vue": "^3.5.32",
    "vue-chartjs": "^5.3.3",
    "vue-i18n": "^11.3.0",
    "vue-tsc": "^3.2.6"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  }
}
