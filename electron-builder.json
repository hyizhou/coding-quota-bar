{
  "appId": "top.hyizhou.codingquotabar",
  "productName": "Coding Quota Bar",
  "copyright": "Copyright © 2026 hyizhou",
  "electronLanguages": [
    "zh-CN",
    "en-US"
  ],
  "compression": "maximum",
  "directories": {
    "output": "release",
    "buildResources": "assets"
  },
  "files": [
    "out/**/*",
    "package.json"
  ],
  "publish": {
    "provider": "github",
    "owner": "hyizhou",
    "repo": "coding-quota-bar"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "assets/icon.png"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64", "x64"]
      },
      {
        "target": "zip",
        "arch": ["arm64", "x64"]
      }
    ],
    "icon": "assets/icon.png",
    "category": "public.app-category.utilities",
    "extendInfo": {
      "LSUIElement": true
    }
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Coding Quota Bar"
  },
  "appx": {
    "applicationId": "CodingQuotaBar",
    "identityName": "hyizhou.CodingQuotaBar",
    "publisher": "CN=4C20EF6A-FC48-4302-81F3-B5234E084521",
    "publisherDisplayName": "hyizhou",
    "displayName": "Coding Quota Bar",
    "languages": ["zh-CN", "en-US"],
    "backgroundColor": "#1f2430",
    "addAutoLaunchExtension": false
  }
}
