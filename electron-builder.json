{
  "appId": "top.hyizhou.codingquotabar",
  "productName": "Coding Quota Bar",
  "copyright": "Copyright © 2026 hyizhou",
  "electronLanguages": [
    "zh-CN",
    "en-US"
  ],
  "compression": "maximum",
  "directories": {
    "output": "release",
    "buildResources": "assets"
  },
  "files": [
    "out/**/*",
    "package.json"
  ],
  "publish": {
    "provider": "github",
    "owner": "hyizhou",
    "repo": "coding-quota-bar"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "assets/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Coding Quota Bar"
  }
}
